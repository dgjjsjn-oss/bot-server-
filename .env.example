# Copy this file to .env and fill in your values

# Your Minecraft server host (IP or domain). Example: dogpvp.falix.gg or 167.235.93.185
MC_HOST=dogpvp.falix.gg

# Your Minecraft server port. Default is 25565
MC_PORT=29349

# Default bot name (auto-summoned on startup; no account needed)
BOT_NAME=wembo

# Port for the web control panel (Render sets PORT automatically)
PORT=3000

# Set to true to auto-ping your Minecraft server from Render every 3 minutes
AUTO_PING_SERVER=true

# Ping interval in milliseconds (default 180000 = 3 minutes)
PING_INTERVAL_MS=180000
