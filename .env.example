# Copy this file to .env and fill in your values

# Your Minecraft server host (IP or domain). Example: mc.example.aternos.me
MC_HOST=your-server-host

# Your Minecraft server port. Default is 25565
MC_PORT=25565

# Default bot name (auto-summoned on startup; no account needed)
BOT_NAME=KeepAliveBot

# Port for the web control panel (Render sets PORT automatically)
PORT=3000
